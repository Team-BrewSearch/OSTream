<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OSTream.ViewModels"
             xmlns:c="using:OSTream.Controls"
             xmlns:m="using:OSTream.Core.Models"
             x:Class="OSTream.Views.Shell.TopBarView"
             x:DataType="vm:TopBarViewModel">
  <UserControl.Styles>
    <Style Selector="Border.brand-mark">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{StaticResource BrandGradient}" />
      <Setter Property="BoxShadow" Value="{DynamicResource BrandGlow}" />
    </Style>
    <Style Selector="Border#Search">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="12,0,8,0" />
      <Setter Property="Background" Value="{DynamicResource Control}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Transitions">
        <Transitions>
          <c:BrushFadeTransition Property="Background" Duration="0:0:0.18" Easing="0.4,0.2,0.2,1" />
          <c:BrushFadeTransition Property="BorderBrush" Duration="0:0:0.18" Easing="0.4,0.2,0.2,1" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="0.4,0.2,0.2,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Search:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Border2}" />
    </Style>
    <Style Selector="Border#Search.focused">
      <Setter Property="Background" Value="{DynamicResource Bg1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource FocusRing}" />
    </Style>
    <Style Selector="Border#Search c|Icon#SearchIcon">
      <Setter Property="Foreground" Value="{DynamicResource Text3}" />
    </Style>
    <Style Selector="Border#Search.focused c|Icon#SearchIcon">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.search-clear">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource Text3}" />
    </Style>
    <Style Selector="Button.search-clear:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource Bg3}" />
    </Style>
    <Style Selector="Border.flyout">
      <Setter Property="Width" Value="312" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowPop}" />
      <Setter Property="RenderTransformOrigin" Value="100%,0%" />
    </Style>
    <Style Selector="Button.theme-option">
      <Setter Property="Padding" Value="6,6,6,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}" />
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Transitions" Value="{StaticResource ButtonTransitions}" />
    </Style>
    <Style Selector="Button.theme-option:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Border3}" />
    </Style>
    <Style Selector="Button.theme-option.on">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.theme-option.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource ThemeOptionSelected}" />
    </Style>
    <Style Selector="Button.theme-option c|IconText">
      <Setter Property="Spacing" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextElement.FontSize" Value="11.5" />
      <Setter Property="TextElement.FontWeight" Value="Medium" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text2}" />
    </Style>
    <Style Selector="Button.theme-option.on c|IconText">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Border.theme-check">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,4,4,0" />
      <Setter Property="RenderTransform" Value="scale(0)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="0.16,1,0.3,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.theme-option.on Border.theme-check">
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Border.preview">
      <Setter Property="Height" Value="58" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderBrush" Value="#40808C8C" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button#Brand">
      <Setter Property="Margin" Value="20,0,16,0" />
      <Setter Property="Padding" Value="0,0,8,0" />
    </Style>
    <Style Selector="c|Icon#SearchIcon">
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="Panel#SearchTail">
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style Selector="StackPanel#Right">
      <Setter Property="Margin" Value="16,0,20,0" />
      <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="Border#Flyout">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,61,20,0" />
    </Style>
    <Style Selector="Border#Search.focused Panel#KbdSlot">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=":is(Control).mobile Button#Brand">
      <Setter Property="Margin" Value="12,0,10,0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector=":is(Control).mobile TextBlock#BrandName, :is(Control).mobile Panel#KbdSlot">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=":is(Control).mobile Border#Search">
      <Setter Property="Padding" Value="10,0,6,0" />
    </Style>
    <Style Selector=":is(Control).mobile c|Icon#SearchIcon">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector=":is(Control).mobile Panel#SearchTail">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector=":is(Control).mobile StackPanel#Right">
      <Setter Property="Margin" Value="10,0,12,0" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector=":is(Control).mobile Border#Format Button.seg">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector=":is(Control).mobile Border#Flyout">
      <Setter Property="Margin" Value="0,72,12,0" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Grid Name="Bar" Height="64" VerticalAlignment="Top" Background="{DynamicResource Glass}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="1000*" MaxWidth="560" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1" IsHitTestVisible="False" />
      <Button Name="Brand" Grid.Column="0" CornerRadius="8" Command="{Binding HomeCommand}"
              ToolTip.Tip="OSTream home" AutomationProperties.Name="OSTream home">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Classes="brand-mark">
            <c:Icon Kind="MusicBrand" Size="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Name="BrandName" Text="OSTream" FontSize="15" FontWeight="SemiBold" LetterSpacing="-0.2" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Border Name="Search" Grid.Column="1" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <c:Icon Name="SearchIcon" Kind="Search" Size="15" />
          <TextBox Name="SearchBox" Grid.Column="1" Text="{Binding SearchText}" FontSize="13"
                   PlaceholderText="Search games, albums, or tracks…" AutomationProperties.Name="Search KHInsider" />
          <Panel Name="SearchTail" Grid.Column="2" VerticalAlignment="Center">
            <Panel Name="KbdSlot"><Border Name="Kbd" Classes="kbd" IsVisible="{Binding !HasValue}"><TextBlock Text="/" /></Border></Panel>
            <c:Spinner Size="14" IsVisible="{Binding IsBusy}" Animate="{Binding IsBusy}" />
            <Button Classes="search-clear" Command="{Binding ClearCommand}" ToolTip.Tip="Clear search" AutomationProperties.Name="Clear search">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasValue" />
                  <Binding Path="!IsBusy" />
                </MultiBinding>
              </Button.IsVisible>
              <c:Icon Kind="XBold" Size="12" />
            </Button>
          </Panel>
        </Grid>
      </Border>
      <StackPanel Name="Right" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Name="Format" Classes="segmented" ToolTip.Tip="Download format">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="seg" Classes.on="{Binding IsFlac}" Content="FLAC" Command="{Binding SetFormatCommand}" CommandParameter="{x:Static m:AudioFormat.Flac}" />
            <Button Classes="seg" Classes.on="{Binding IsWav}" Content="WAV" Command="{Binding SetFormatCommand}" CommandParameter="{x:Static m:AudioFormat.Wav}" />
            <Button Classes="seg" Classes.on="{Binding IsMp3}" Content="MP3" Command="{Binding SetFormatCommand}" CommandParameter="{x:Static m:AudioFormat.Mp3}" />
            <Button Classes="seg" Classes.on="{Binding IsOgg}" Content="OGG" Command="{Binding SetFormatCommand}" CommandParameter="{x:Static m:AudioFormat.Ogg}" />
          </StackPanel>
        </Border>
        <Button Name="SettingsButton" Classes="icon-btn" Classes.expanded="{Binding IsSettingsOpen}" Command="{Binding ToggleSettingsCommand}"
                ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
          <c:Icon Kind="Settings" Size="16" />
        </Button>
      </StackPanel>
    </Grid>
    <Border Name="Flyout" Classes="flyout" IsVisible="{Binding IsSettingsOpen}" c:Entrance.Kind="pop-in">
      <Panel>
        <c:Backdrop Tint="{DynamicResource Popover}" Blur="24" CornerRadius="14" Margin="-16" />
        <StackPanel Spacing="0">
          <StackPanel Margin="0,0,0,14" Spacing="2">
            <TextBlock Text="Theme" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="Choose how OSTream looks." FontSize="11.5" Foreground="{DynamicResource Text3}" />
          </StackPanel>
          <UniformGrid Name="ThemeOptions" Columns="3" ColumnSpacing="8">
            <Button Classes="theme-option" AutomationProperties.Name="System theme" Classes.on="{Binding IsSystemTheme}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static m:ThemeChoice.System}">
              <Panel>
                <StackPanel Spacing="8">
                  <Border Classes="preview">
                    <Panel>
                      <Border Name="PreviewLight1" Background="#f5f5f8" Padding="7"><c:PreviewBars Dark="False" /></Border>
                      <c:DiagonalClip><Border Background="#0e0e13" Padding="7"><c:PreviewBars Dark="True" /></Border></c:DiagonalClip>
                    </Panel>
                  </Border>
                  <c:IconText Kind="Monitor" IconSize="13" Text="System" />
                </StackPanel>
                <Border Classes="theme-check"><c:Icon Kind="CheckBold" Size="10" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              </Panel>
            </Button>
            <Button Classes="theme-option" AutomationProperties.Name="Light theme" Classes.on="{Binding IsLightTheme}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static m:ThemeChoice.Light}">
              <Panel>
                <StackPanel Spacing="8">
                  <Border Classes="preview"><Border Background="#f5f5f8" Padding="7"><c:PreviewBars Dark="False" /></Border></Border>
                  <c:IconText Kind="Sun" IconSize="13" Text="Light" />
                </StackPanel>
                <Border Classes="theme-check"><c:Icon Kind="CheckBold" Size="10" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              </Panel>
            </Button>
            <Button Classes="theme-option" AutomationProperties.Name="Dark theme" Classes.on="{Binding IsDarkTheme}" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static m:ThemeChoice.Dark}">
              <Panel>
                <StackPanel Spacing="8">
                  <Border Classes="preview"><Border Background="#0e0e13" Padding="7"><c:PreviewBars Dark="True" /></Border></Border>
                  <c:IconText Kind="Moon" IconSize="13" Text="Dark" />
                </StackPanel>
                <Border Classes="theme-check"><c:Icon Kind="CheckBold" Size="10" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              </Panel>
            </Button>
          </UniformGrid>
          <Border Classes="divider" Margin="0,16,0,14" />
          <StackPanel Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="Download folder" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DownloadDir}" FontSize="11" Classes="mono" Foreground="{DynamicResource Text3}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="btn secondary sm" Command="{Binding ChangeDownloadDirCommand}">
              <c:IconText Kind="Folder" IconSize="13" Text="Change…" />
            </Button>
            <Button Classes="btn ghost sm" Command="{Binding OpenDownloadDirCommand}">
              <c:IconText Kind="External" IconSize="13" Text="Open" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Panel>
    </Border>
  </Panel>
</UserControl>