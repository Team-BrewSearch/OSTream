<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OSTream.ViewModels"
             xmlns:c="using:OSTream.Controls"
             x:Class="OSTream.Views.Pages.RecentView"
             x:DataType="vm:RecentViewModel">
  <StackPanel c:Entrance.Kind="fade-up">
    <c:SectionHead AlignBottom="True" Grow="True" RowGap="14" Margin="0,0,0,22">
      <StackPanel MinWidth="200">
        <TextBlock Classes="eyebrow" Text="COLLECTION" Margin="0,0,0,6" />
        <TextBlock Classes="h1" Text="Recently played" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEmpty}">
        <Button Classes="btn primary sm" Command="{Binding PlayAllCommand}"><c:IconText Kind="Play" IconSize="12" Text="Play all" /></Button>
        <Button Classes="btn ghost sm" Command="{Binding ClearCommand}"><c:IconText Kind="Trash" IconSize="13" Text="Clear history" /></Button>
      </StackPanel>
    </c:SectionHead>
    <c:StateBlock IsVisible="{Binding IsEmpty}" Icon="Clock" Title="Nothing played yet" Text="Tracks you listen to show up here, newest first."
                  c:Entrance.Kind="fade-up">
      <Button Classes="btn secondary sm" Command="{Binding BrowseCommand}"><c:IconText Kind="Home" IconSize="13" Text="Browse albums" /></Button>
    </c:StateBlock>
    <ContentControl Content="{Binding Tracks}" />
  </StackPanel>
</UserControl>