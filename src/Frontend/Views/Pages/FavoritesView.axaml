<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OSTream.ViewModels"
              xmlns:c="using:OSTream.Frontend.Controls"
             xmlns:comp="using:OSTream.Views.Components"
             x:Class="OSTream.Views.Pages.FavoritesView"
             x:DataType="vm:FavoritesViewModel">
  <StackPanel c:Entrance.Kind="fade-up">
    <c:SectionHead AlignBottom="True" Grow="True" RowGap="14" Margin="0,0,0,22">
      <StackPanel MinWidth="200">
        <TextBlock Classes="eyebrow" Text="LIBRARY" Margin="0,0,0,6" />
        <TextBlock Classes="h1" Text="Favorites" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowActions}">
        <Button Classes="btn primary sm" Command="{Binding PlayAllCommand}"><c:IconText Kind="Play" IconSize="12" Text="Play all" /></Button>
        <Button Classes="btn secondary sm" Command="{Binding ShuffleCommand}"><c:IconText Kind="Shuffle" IconSize="12" Text="Shuffle" /></Button>
      </StackPanel>
    </c:SectionHead>
    <Panel Margin="0,0,0,16" MinHeight="32">
      <Border Classes="segmented small" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="seg" AutomationProperties.Name="Albums" Classes.on="{Binding IsAlbumsTab}" Command="{Binding ShowTabCommand}" CommandParameter="albums">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Albums" VerticalAlignment="Center" />
              <TextBlock Classes="count" Text="{Binding AlbumCount}" />
            </StackPanel>
          </Button>
          <Button Classes="seg" AutomationProperties.Name="Tracks" Classes.on="{Binding IsTracksTab}" Command="{Binding ShowTabCommand}" CommandParameter="tracks">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Tracks" VerticalAlignment="Center" />
              <TextBlock Classes="count" Text="{Binding TrackCount}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Panel>
    <c:StateBlock IsVisible="{Binding NoAlbums}" Icon="Heart" Title="No favorite albums yet" Text="Open any album and choose “Add to favorites” to keep it here."
                  c:Entrance.Kind="fade-up">
      <Button Classes="btn secondary sm" Command="{Binding BrowseCommand}"><c:IconText Kind="Home" IconSize="13" Text="Browse albums" /></Button>
    </c:StateBlock>
    <c:StateBlock IsVisible="{Binding NoTracks}" Icon="Heart" Title="No favorite tracks yet" Text="Tap the heart on any track to save it here."
                  c:Entrance.Kind="fade-up" />
    <comp:AlbumGrid ItemsSource="{Binding Cards}" IsVisible="{Binding ShowGrid}" Margin="0,0,0,20" />
    <ContentControl Content="{Binding Tracks}" IsVisible="{Binding ShowTracks}" />
    <comp:AlbumPanelView Name="Panel" DataContext="{Binding Panel}" />
  </StackPanel>
</UserControl>