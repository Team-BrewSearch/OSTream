<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OSTream.ViewModels"
             xmlns:c="using:OSTream.Controls"
             xmlns:comp="using:OSTream.Views.Components"
             x:Class="OSTream.Views.Pages.DownloadsView"
             x:DataType="vm:DownloadsViewModel">
  <StackPanel c:Entrance.Kind="fade-up">
    <c:SectionHead AlignBottom="True" Grow="True" RowGap="14" Margin="0,0,0,22">
      <StackPanel MinWidth="200">
        <TextBlock Classes="eyebrow" Text="LIBRARY" Margin="0,0,0,6" />
        <TextBlock Classes="h1" Text="Downloads" />
        <TextBlock Classes="mono" Text="{Binding Path, Converter={x:Static c:Converters.BreakAll}}" FontSize="11" Foreground="{DynamicResource Text3}"
                   Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Panel MinHeight="32"><TextBlock Classes="sub" Text="{Binding Summary}" VerticalAlignment="Center" /></Panel>
        <Button Classes="btn secondary sm" VerticalAlignment="Top" Command="{Binding OpenFolderCommand}"><c:IconText Kind="Folder" IconSize="13" Text="Open folder" /></Button>
        <Button Classes="btn ghost sm" VerticalAlignment="Top" IsEnabled="{Binding CanClear}" Command="{Binding ClearFinishedCommand}"><c:IconText Kind="Trash" IconSize="13" Text="Clear finished" /></Button>
      </StackPanel>
    </c:SectionHead>
    <c:StateBlock IsVisible="{Binding IsEmpty}" Icon="Downloads" Title="No downloads yet" c:Entrance.Kind="fade-up"
                  Text="Open an album and choose “Download all”, or use the download button on any track. Files are saved straight to your download folder.">
      <Button Classes="btn secondary sm" Command="{Binding BrowseCommand}"><c:IconText Kind="Home" IconSize="13" Text="Browse albums" /></Button>
    </c:StateBlock>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="920" /></Grid.ColumnDefinitions>
      <ItemsControl ItemsSource="{Binding Jobs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:JobCardViewModel">
            <comp:JobCardView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </StackPanel>
</UserControl>