<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OSTream.Frontend.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type c:StateBlock}" TargetType="c:StateBlock">
        <Setter Property="Padding" Value="24,56" />
        <Setter Property="Template">
          <ControlTemplate>
            <c:DashedBorder Name="frame" Padding="{TemplateBinding Padding}" CornerRadius="14"
                            Stroke="{DynamicResource Border2}" Background="Transparent">
              <StackPanel HorizontalAlignment="Center" Spacing="10">
                <Border Name="tile" Width="44" Height="44" CornerRadius="12" Margin="0,0,0,4" HorizontalAlignment="Center"
                        Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                  <c:Icon Name="icon" Kind="{TemplateBinding Icon}" Size="18" Foreground="{DynamicResource Text2}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{TemplateBinding Text}" FontSize="12.5" Foreground="{DynamicResource Text3}" MaxWidth="420"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="19"
                           IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                  IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </c:DashedBorder>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.error /template/ Border#tile">
          <Setter Property="Background" Value="{DynamicResource RedSoft}" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^.error /template/ c|Icon#icon">
          <Setter Property="Foreground" Value="{DynamicResource Red}" />
        </Style>
        <Style Selector="^.compact">
          <Setter Property="Padding" Value="16,28" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="TextBlock">
    <Setter Property="LineHeight" Value="{Binding $self.FontSize, Converter={x:Static c:Converters.LineHeight}, ConverterParameter=1.5}" />
  </Style>
  <Style Selector="TextBlock.h1, TextBlock.detail-title">
    <Setter Property="LineHeight" Value="{Binding $self.FontSize, Converter={x:Static c:Converters.LineHeight}, ConverterParameter=1.15}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.05" />
    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.84" />
    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
  </Style>
  <Style Selector="TextBlock.ellipsis">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="Button.btn">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Transitions" Value="{StaticResource ButtonTransitions}" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Button.btn c|IconText">
    <Setter Property="Spacing" Value="7" />
  </Style>
  <Style Selector="Button.btn.sm">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.btn.sm c|IconText">
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="Button.btn.icon">
    <Setter Property="Width" Value="38" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.btn.sm.icon">
    <Setter Property="Width" Value="30" />
  </Style>
  <Style Selector="Button.btn.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.btn.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource Glow20}" />
  </Style>
  <Style Selector="Button.btn.primary:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Accent2}" />
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>
  <Style Selector="Button.btn.primary:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource Glow28}" />
  </Style>
  <Style Selector="Button.btn.secondary">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.btn.secondary:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border3}" />
  </Style>
  <Style Selector="Button.btn.ghost">
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Button.btn.sm.ghost">
    <Setter Property="Padding" Value="11,0" />
  </Style>
  <Style Selector="Button.btn.icon.ghost">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.btn.ghost:pointerover:not(:disabled)">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
  </Style>
  <Style Selector="Button.btn.ghost.on, Button.btn.ghost.on:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Accent2}" />
  </Style>
  <Style Selector="Button.btn.danger, Button.btn.danger:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Red}" />
  </Style>
  <Style Selector="Button.btn.danger:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource RedSoft}" />
  </Style>
  <Style Selector="Button.icon-btn">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="{DynamicResource Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border1}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="Transitions" Value="{StaticResource ButtonTransitions}" />
  </Style>
  <Style Selector="Button.icon-btn.small">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector="Button.icon-btn:pointerover, Button.icon-btn.expanded">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border2}" />
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>
  <Style Selector="Button.icon-btn c|Icon">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="0.16,1,0.3,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.icon-btn.expanded c|Icon">
    <Setter Property="RenderTransform" Value="rotate(45deg)" />
  </Style>
  <Style Selector="Button.text-link">
    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.text-link c|IconText">
    <Setter Property="Spacing" Value="5" />
  </Style>
  <Style Selector="Button.text-link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Accent2}" />
  </Style>
  <Style Selector="Border.segmented">
    <Setter Property="Padding" Value="3" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="{DynamicResource Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border1}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.segmented.small">
    <Setter Property="Height" Value="32" />
  </Style>
  <Style Selector="Border.segmented Button.seg">
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Transitions" Value="{StaticResource ButtonTransitions}" />
  </Style>
  <Style Selector="Border.segmented.small Button.seg">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="Border.segmented Button.seg:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style Selector="Border.segmented Button.seg.on">
    <Setter Property="Background" Value="{DynamicResource ControlActive}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Border.segmented Button.seg.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource SegmentedActiveShadow}" />
  </Style>
  <Style Selector="Border.segmented Button.seg TextBlock.count">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.segmented Button.seg.on TextBlock.count">
    <Setter Property="Foreground" Value="{DynamicResource Accent2}" />
  </Style>
  <Style Selector="Border.tag">
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border2}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.tag > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style Selector="Border.tag.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
  </Style>
  <Style Selector="Border.tag.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Accent2}" />
  </Style>
  <Style Selector="Border.tag.warn">
    <Setter Property="BorderBrush" Value="{DynamicResource Amber}" />
  </Style>
  <Style Selector="Border.tag.warn > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
  </Style>
  <Style Selector="TextBox.input">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{DynamicResource Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border1}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Transitions">
      <Transitions>
        <c:BrushFadeTransition Property="Border.BorderBrush" Duration="0:0:0.18" Easing="0.4,0.2,0.2,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox.input:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="TextBox.input:focus /template/ Border#border">
    <Setter Property="BoxShadow" Value="{DynamicResource FocusRing}" />
  </Style>
    <Style Selector="Border.album-card">
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <c:BrushFadeTransition Property="Border.BorderBrush" Duration="0:0:0.18" Easing="0.4,0.2,0.2,1" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="0.4,0.2,0.2,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.card">
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="0.4,0.2,0.2,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.card:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-3px)" />
    </Style>
    <Style Selector="Panel.card:pointerover Border.album-card">
      <Setter Property="BorderBrush" Value="{DynamicResource Border2}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardHover}" />
    </Style>
    <Style Selector="Panel.card.sel Border.album-card">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardSelected}" />
    </Style>
    <Style Selector="Panel.card.sel:pointerover Border.album-card">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardSelected}" />
    </Style>
    <Style Selector="Border.album-shade">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.card:pointerover Border.album-shade, Panel.card.sel Border.album-shade">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel.card.sel TextBlock.card-title">
      <Setter Property="Foreground" Value="{DynamicResource Accent2}" />
    </Style>
    <Style Selector="Button.album-link">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.album-play">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(6px) scale(0.9)" />
      <Setter Property="Transitions" Value="{StaticResource ButtonTransitions}" />
    </Style>
    <Style Selector="Button.album-play /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource AlbumPlayShadow}" />
    </Style>
    <Style Selector="Panel.card:pointerover Button.album-play, Button.album-play.busy, Button.album-play:focus-visible">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Panel.card Button.album-play:pointerover">
      <Setter Property="Background" Value="{DynamicResource Accent2}" />
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Button.album-play c|Spinner">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Border.album-rank">
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="#8C000000" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="8,8,0,0" />
    </Style>
    <Style Selector="Grid.detail">
      <Setter Property="Margin" Value="0,0,0,26" />
    </Style>
    <Style Selector=":is(Control).detail-art">
      <Setter Property="Width" Value="180" />
      <Setter Property="Height" Value="180" />
      <Setter Property="Margin" Value="0,0,22,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector=":is(Control).compact :is(Control).detail-art">
      <Setter Property="Width" Value="150" />
      <Setter Property="Height" Value="150" />
    </Style>
    <Style Selector=":is(Control).mobile :is(Control).detail-art">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MaxWidth" Value="260" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector=":is(Control).mobile :is(Control).detail-info">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="TextBlock.detail-title">
      <Setter Property="FontSize" Value="28" />
    </Style>
    <Style Selector=":is(Control).mobile TextBlock.detail-title">
      <Setter Property="FontSize" Value="22" />
    </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Border1}" />
  </Style>
  <Style Selector="c|Spinner">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="c|Skeleton">
    <Setter Property="BaseBrush" Value="{DynamicResource Skeleton}" />
    <Setter Property="ShineBrush" Value="{DynamicResource SkeletonShineGradient}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border2}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LineHeight" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Text3}" />
  </Style>
  <Style Selector="Run.rich-strong">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style Selector="Run.rich-separator">
    <Setter Property="Foreground" Value="{DynamicResource Text3Dim}" />
  </Style>
</Styles>