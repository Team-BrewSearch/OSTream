<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>OSTream.Core</AssemblyName>
    <RootNamespace>OSTream.Core</RootNamespace>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsRidAgnostic>false</IsRidAgnostic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="1.0.0-rc.2" />
    <!-- Linux resolves OpenAL from the system: the bundled 1.23.1 enables full HRTF rendering on the pulse backend. -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" Condition="!$(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OSTream" />
    <InternalsVisibleTo Include="OSTream.Frontend" />
  </ItemGroup>
</Project>
